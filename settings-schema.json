{
    "menu-section": {
        "type": "header",
        "description": "Menu Settings"
    },

    "showCountry": {
        "type": "switch",
        "default": true,
        "description": "Show Exit Country"
    },

    "showCity": {
        "type": "switch",
        "default": true,
        "description": "Show Exit City"
    },

    "showIP": {
        "type": "switch",
        "default": true,
        "description": "Show Exit IP Address"
    },

    "tor-section": {
        "type": "header",
        "description": "Tor Settings"
    },

    "tor-host": {
        "type": "entry",
        "default": "127.0.0.1",
        "description": "Tor Host"
    },

    "socks-port": {
        "type": "spinbutton",
        "default": 9050,
        "min": 1,
        "max": 65535,
        "step": 1,
        "description": "SOCKS Port"
    },

    "control-port": {
        "type": "spinbutton",
        "default": 9051,
        "min": 1,
        "max": 65535,
        "step": 1,
        "description": "Control Port"
    },

    "refresh-interval": {
        "type": "spinbutton",
        "default": 15,
        "min": 5,
        "max": 300,
        "step": 5,
        "description": "Refresh Interval (seconds)"
    },

    "auto-proxy": {
        "type": "switch",
        "default": true,
        "description": "Enable Proxy when Tor starts"
    }
}
